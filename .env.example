# Copy to .env.local (and set the same values in Vercel → Settings → Environment Variables)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# Payments: Paddle → Developer tools → Authentication → client-side token (public, starts with test_ or live_)
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENV=sandbox
# Show "Sign in with Google" (enable the provider in Supabase first)
VITE_GOOGLE_AUTH_ENABLED=false
